generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String
  venue           String
  total_seats     Int
  available_seats Int
  price           Decimal  @db.Decimal(10, 2)
  date            DateTime
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([date])
  @@map("events")
}
