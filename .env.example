# Shared
NODE_ENV=development
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=24h

# Postgres — User Service
USERS_DB_HOST=users_db
USERS_DB_PORT=5432
USERS_DB_NAME=users_db
USERS_DB_USER=ticketmaster
USERS_DB_PASSWORD=ticketmaster

# Postgres — Event Service
EVENTS_DB_HOST=events_db
EVENTS_DB_PORT=5432
EVENTS_DB_NAME=events_db
EVENTS_DB_USER=ticketmaster
EVENTS_DB_PASSWORD=ticketmaster

# Postgres — Booking Service
BOOKINGS_DB_HOST=bookings_db
BOOKINGS_DB_PORT=5432
BOOKINGS_DB_NAME=bookings_db
BOOKINGS_DB_USER=ticketmaster
BOOKINGS_DB_PASSWORD=ticketmaster

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
SEAT_HOLD_TTL_MS=600000
SEAT_HOLD_TTL_SECONDS=600

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ticketmaster
RABBITMQ_PASSWORD=ticketmaster
RABBITMQ_URL=amqp://ticketmaster:ticketmaster@rabbitmq:5672
RABBITMQ_EXCHANGE=booking_events
RABBITMQ_ROUTING_KEY=booking.confirmed
RABBITMQ_QUEUE=booking.confirmed

# Service ports (host-side; containers use internal ports)
USER_SERVICE_PORT=3001
EVENT_SERVICE_PORT=3002
BOOKING_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
FRONTEND_PORT=3000
